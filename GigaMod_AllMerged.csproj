<Project Sdk="Microsoft.NET.Sdk">

	<!--
	================================================================================
	GIGA MOD - UNIFIED PROJECT FILE FOR ALL 5 MERGED MODS
	================================================================================
	This project file combines all dependencies and resources from:
	1. Suppress Rework (SupressRework.csproj)
	2. Void Fiend Beam (Voidfiendbeam.csproj)  
	3. Void VFX Update (VoidVFXUpdate.csproj)
	4. Omnispark Prefab Change (Template.csproj)
	5. Billboard Fire Editor (billboarfire.csproj)
	6. Void Survivor Beam Impact Color Change (Impactcolornoncorrupt.csproj)
	================================================================================
	-->

	<PropertyGroup>
		<!-- Target Framework matching all mods -->
		<TargetFramework>netstandard2.1</TargetFramework>
		<!-- Root namespace for the giga mod -->
		<RootNamespace>GigaMod_AllMerged</RootNamespace>
		<!-- Enable nullable reference types -->
		<Nullable>enable</Nullable>
		<!-- Use latest C# language version -->
		<LangVersion>latest</LangVersion>
		<!-- Assembly name -->
		<AssemblyName>GigaMod_AllMerged</AssemblyName>
	</PropertyGroup>

	<!-- 
	================================================================================
	EMBEDDED RESOURCES - ALL PNG FILES FROM ALL MODS
	================================================================================
	-->
	<ItemGroup>
		<!-- Suppress Rework icon -->
		<EmbeddedResource Include="SuppressRework_icon.png">
			<LogicalName>V8_supressrework.icon.png</LogicalName>
		</EmbeddedResource>
		
		<!-- Void Fiend Beam icon -->
		<EmbeddedResource Include="VoidFiendBeam_icon.png">
			<LogicalName>VoidFiendBeam.icon.png</LogicalName>
		</EmbeddedResource>
		
		<!-- Omnispark red texture -->
		<EmbeddedResource Include="OmnisparkRed.png">
			<LogicalName>template.OmnisparkRed.png</LogicalName>
		</EmbeddedResource>
		
		<!-- Custom ramp texture -->
		<EmbeddedResource Include="Custom_ramp.png">
			<LogicalName>template.Custom_ramp.png</LogicalName>
		</EmbeddedResource>
		
		<!-- Custom billboard flame texture -->
		<EmbeddedResource Include="Custombillboardflame.png">
			<LogicalName>template.custombillboardflame.png</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- 
	================================================================================
	PACKAGE REFERENCES - UNIFIED AND DEDUPLICATED FROM ALL MODS
	================================================================================
	Using the most recent versions found across all projects
	-->
	<ItemGroup>
		<!-- BepInEx Core Dependencies -->
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RoR2.BepInEx.Analyzers" Version="1.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RoR2BepInExPack" Version="1.33.0" />

		<!-- Risk of Rain 2 Game Libraries -->
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.3.9-r.0" />
		<PackageReference Include="UnityEngine.Modules" Version="2019.4.26" />
		
		<!-- MMHOOK for Risk of Rain 2 -->
		<PackageReference Include="MMHOOK.RoR2" Version="2025.6.3" />

		<!-- R2API Dependencies - All modules from all mods -->
		<PackageReference Include="R2API.Core" Version="5.1.6" />
		<PackageReference Include="R2API.ContentManagement" Version="1.0.10" />
		<PackageReference Include="R2API.DamageType" Version="1.1.7" />
		<PackageReference Include="R2API.Dot" Version="1.0.4" />
		<PackageReference Include="R2API.Items" Version="1.0.7" />
		<PackageReference Include="R2API.Language" Version="1.0.1" />
		<PackageReference Include="R2API.Networking" Version="1.0.3" />
		<PackageReference Include="R2API.Prefab" Version="1.1.1" />
		<PackageReference Include="R2API.RecalculateStats" Version="1.6.1" />
		<PackageReference Include="R2API.Skills" Version="1.0.2" />
		<PackageReference Include="R2API.Skins" Version="1.2.2" />
		<PackageReference Include="R2API.Sound" Version="1.0.3" />

		<!-- Risk of Options - Used by multiple mods -->
		<PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.3" />
	</ItemGroup>

	<!-- 
	================================================================================
	BUILD CONFIGURATION
	================================================================================
	-->
	<PropertyGroup>
		<!-- Optimize for release builds -->
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
		<!-- Generate debug symbols -->
		<DebugType>portable</DebugType>
		<!-- Suppress specific warnings -->
		<NoWarn>CS8618,CS8601,CS8600,CS8625</NoWarn>
	</PropertyGroup>

</Project>